---
import type { CategoryCard, CategoryDelivery } from '../../../shared/site-delivery';
import type { ArticleDelivery } from '../../../shared/article-delivery';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import '../styles/category.css';
import ContentImage from '../components/ContentImage.astro';
import MoqDetails from '../components/MoqDetails.astro';
import JournalCard from '../components/JournalCard.astro';
import PendingContact from '../components/PendingContact.astro';
import FAQ from '../components/FAQ.astro';
interface Props { category: CategoryDelivery; related: CategoryCard[]; articles?: ArticleDelivery[]; brandName: string }
const { category, related, articles = [], brandName } = Astro.props;
const cms = category.kind === 'cms_category' ? category : null;
const concept = category.kind === 'category_preview' ? category : null;
---
<BaseLayout title={category.seo.seoTitle} description={category.seo.seoDescription} brandName={brandName} showMobileContact referenceCode={category.referenceCode}>
  <Breadcrumb label={category.name} />
  <div class="category-page" data-page-source={cms ? 'sanity' : 'local'} data-page-status={cms ? 'cms_published' : 'concept_only'} data-page-revision={cms?.revision} data-production-allowed="false" data-content-updated-at={cms?.contentUpdatedAt}>
  <section class="category-hero shell" aria-labelledby="category-title" data-category={category.slug} data-reference-code={category.referenceCode}>
    <div class="category-hero-copy">
      <p class="eyebrow">{cms ? 'Published CMS category / Manufacturing enquiry' : 'Concept category / Manufacturing enquiry'}</p>
      <h1 id="category-title">{category.title.split(/(T-shirt)/).map(part => part === 'T-shirt' ? <span class="short-word-unit">{part}</span> : part)}</h1>
      <p class="intro">{category.intro}</p>
      <p class="fact-note">{cms ? `Fact-confirmation date recorded: ${cms.factConfirmedAt}. Website release is not verified.` : 'Proposed category. Production availability is unconfirmed.'}</p>
      <PendingContact id="category-contact-note" referenceCode={category.referenceCode} />
      <a class="text-link" href="#discussion">{cms ? 'Review capabilities' : 'Shape your brief'} <span aria-hidden="true">↗</span></a>
    </div>
    <ContentImage image={cms ? cms.heroImage : concept!.image} label={`${category.name}${cms ? '' : ' concept'}`} priority sizes="(min-width: 1440px) 650px, (min-width: 1024px) 50vw, (min-width: 768px) 48vw, calc(100vw - 40px)" />
  </section>
  {concept && <section class="section-row shell category-concept" aria-labelledby="concept-heading">
    <div class="section-grid"><div><p class="eyebrow">Concept study / One image</p><h2 id="concept-heading">{concept.concept.title}</h2><p class="section-note">{concept.concept.description}</p></div>
      <div class="concept-observations">{concept.concept.observations.map((observation, index) => <article><p class="eyebrow">0{index + 1} / Discussion cue</p><h3>{observation.title}</h3><p>{observation.description}</p></article>)}</div>
    </div>
  </section>}
  {cms && <section class="section-row shell" id="samples" aria-labelledby="samples-heading">
    <p class="eyebrow">Sample records</p><h2 id="samples-heading">{cms.name} samples.</h2>
    <div class="sample-grid">{cms.samples.map(sample => <article class="sample-card" data-sample-code={sample.sampleCode}>
      <div class="sample-images">{sample.images.map(image => <ContentImage image={image} label={sample.name} sizes="(min-width: 1024px) 400px, (min-width: 768px) 45vw, calc(100vw - 40px)" />)}</div>
      <p class="eyebrow sample-code">{sample.sampleCode}</p><h3>{sample.name}</h3><p class="sample-summary">{sample.summary}</p>
      {(sample.fabric || sample.weightGsm !== null || sample.fit || sample.techniqueNotes) && <dl class="sample-specifications">
        {sample.fabric && <div><dt>Fabric</dt><dd>{sample.fabric}</dd></div>}
        {sample.weightGsm !== null && <div><dt>Weight</dt><dd>{sample.weightGsm} GSM</dd></div>}
        {sample.fit && <div><dt>Fit</dt><dd>{sample.fit}</dd></div>}
        {sample.techniqueNotes && <div><dt>Technique notes</dt><dd>{sample.techniqueNotes}</dd></div>}
      </dl>}
      <PendingContact id={`sample-${sample.sampleCode}-contact-note`} referenceCode={cms.referenceCode} sampleCode={sample.sampleCode} />
    </article>)}</div>
  </section>}
  <section class="section-row shell" id="discussion" tabindex="-1" aria-labelledby="discussion-heading">
    <div class="section-grid">
      <div><p class="eyebrow">{cms ? 'Capabilities and limitations' : 'To discuss with the factory'}</p><h2 id="discussion-heading">{cms ? 'Manufacturing details.' : 'Start with the details.'}</h2>{concept && <p class="section-note">Questions for a manufacturing conversation, not a list of confirmed services.</p>}</div>
      <dl class="discussion-list">{concept ? concept.discussion.map(row => <div><dt>{row.title}</dt><dd>{row.description}</dd></div>) : cms?.capabilityRows.map(row => <div><dt>{row.name}</dt><dd>{row.description}{row.limitNote && <p class="capability-limit">Limits: {row.limitNote}</p>}</dd></div>)}</dl>
    </div>
  </section>
  {cms && <section class="section-row shell section-grid" aria-labelledby="customization-heading"><div><p class="eyebrow">Customization</p><h2 id="customization-heading">Options and scope.</h2></div><div><p>{cms.customizationNotes}</p><a class="text-link" href="/manufacturing/#options">Manufacturing options <span aria-hidden="true">↗</span></a></div></section>}
  <section class="section-row shell category-terms" aria-labelledby="terms-heading">
    <div><p class="eyebrow">{cms ? 'Category terms' : 'Terms awaiting confirmation'}</p><h2 id="terms-heading">MOQ &amp; sampling.</h2></div>
    <div class="terms-grid"><article><h3>Minimum quantities</h3>{cms ? <MoqDetails policy={cms.effectiveMoq} inheritance={cms.moqMode} /> : <p>{concept!.moqNotes}</p>}<a class="text-link" href="/manufacturing/#moq">Understand quantity questions <span aria-hidden="true">↗</span></a></article><article><h3>Developing a sample</h3><p>{category.samplingNotes}</p><a class="text-link" href="/manufacturing/#sampling">Plan a sample discussion <span aria-hidden="true">↗</span></a></article></div>
  </section>
  {cms && <section class="section-row shell" aria-labelledby="evidence-heading"><p class="eyebrow">Category evidence records</p><h2 id="evidence-heading">Details to review.</h2><div class="evidence-grid">{cms.evidenceImages.map(image => <ContentImage image={image} label="Category detail" sizes="(min-width: 1024px) 600px, calc(100vw - 40px)" />)}</div></section>}
  <section class="section-row shell" aria-labelledby="category-faq-heading">
    <div class="section-grid"><div><p class="eyebrow">Before the conversation</p><h2 id="category-faq-heading">{category.name}, considered.</h2></div><FAQ items={category.faqItems} /></div>
  </section>
  {articles.length > 0 && <section class="section-row shell" aria-labelledby="category-articles-heading"><p class="eyebrow">Journal</p><h2 id="category-articles-heading">Related reading.</h2><div class="journal-grid home-journal-grid">{articles.map(article => <JournalCard article={article} home />)}</div></section>}
  {related.length > 0 && <section class="section-row shell related-category" aria-labelledby="related-heading"><div><p class="eyebrow">Another direction</p><h2 id="related-heading">{cms ? 'Explore the other category.' : 'Explore the other concept.'}</h2></div>{related.map(item => <a class="related-category-link" href={item.path}><span><strong>{item.name}</strong><span>{item.summary}</span></span><span aria-hidden="true">↗</span></a>)}</section>}
  <section class="section-row shell category-next" aria-labelledby="category-next-heading"><h2 id="category-next-heading">Continue the conversation.</h2><div><a class="text-link" href="/our-factory/">Explore our factory profile <span aria-hidden="true">↗</span></a><a class="text-link" href="/contact/">View contact options <span aria-hidden="true">↗</span></a></div></section>
  </div>
</BaseLayout>
