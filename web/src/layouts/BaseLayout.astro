---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; brandName: string; home?: boolean }
const { title, description, brandName, home = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'has-mobile-contact': home }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="preview-notice">Concept preview — placeholder branding, unconfirmed factory details and independent imagery pending.</div>
    <Header brandName={brandName} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer brandName={brandName} home={home} />
    <script>import '../scripts/navigation';</script>
  </body>
</html>
