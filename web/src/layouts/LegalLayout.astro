---
import type { FixedPageDeliveries } from '../../../shared/fixed-delivery';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import EditorialBody from '../components/EditorialBody.astro';
import '../styles/editorial.css';
interface Props { notice: FixedPageDeliveries['privacy']; brandName: string }
const { notice, brandName } = Astro.props;
---
<BaseLayout title={notice.seo.seoTitle} description={notice.seo.seoDescription} brandName={brandName} referenceCode={null}>
  <Breadcrumb label="Privacy" />
  <article class="legal-page shell" data-preview-kind="legal_preview" data-preview-status={notice.policyStatus} data-page-source={notice.source} data-page-status={notice.status} data-page-revision={notice.revision} data-policy-status={notice.policyStatus} data-legal-review-status={notice.legalReviewStatus} data-production-allowed="false">
    <header><p class="eyebrow">{notice.eyebrow}</p><h1>{notice.title}</h1>{notice.intro && <p class="intro">{notice.intro}</p>}<p class="draft-status">Draft privacy notice — not in effect</p>{notice.legalReviewedAt && <p class="small-copy">Legal review recorded on {notice.legalReviewedAt}; this does not activate the policy or publish the website.</p>}</header>
    <EditorialBody body={notice.body} />
  </article>
</BaseLayout>
