---
import type { ArticlePreview } from '../../../shared/editorial';
import type { CmsArticleDraftPreviewData } from '../../../shared/cms-draft-preview';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PreviewImage from '../components/PreviewImage.astro';
import EditorialBody from '../components/EditorialBody.astro';
import { prepareEditorialBody } from '../lib/editorial';
import '../styles/editorial.css';
interface Props { article: ArticlePreview | CmsArticleDraftPreviewData; brandName: string }
const { article, brandName } = Astro.props;
const cmsDraft = article.kind === 'cms_article_draft_preview';
const { toc } = prepareEditorialBody(article.body);
---
<BaseLayout title={article.seo.seoTitle} description={article.seo.seoDescription} brandName={brandName} showMobileContact referenceCode={article.referenceCode}>
  <Breadcrumb label={article.title} journalParent />
  <article class="article-page shell" data-preview-kind={article.kind} data-preview-status={article.status} data-production-allowed="false" data-article-slug={article.slug}>
    <header class="article-header">
      <p class="eyebrow">Journal / Buying with clarity</p>
      <p class="draft-status">{cmsDraft ? 'CMS draft preview / Not published' : 'Editorial draft / Not published'}</p>
      <h1>{article.title}</h1>
      <p class="intro">{article.excerpt}</p>
      {cmsDraft
        ? <p class="small-copy">CMS draft saved: <time datetime={article.draftSavedAt}>{article.draftSavedAt}</time> — technical save time only; not a publication or fact-review date.</p>
        : article.draftUpdatedAt && <p class="small-copy">Draft updated: <time datetime={article.draftUpdatedAt}>{article.draftUpdatedAt}</time> — not a publication or review date.</p>}
    </header>
    {!cmsDraft && <div class="article-cover" data-cover-usage={article.cover.usage} data-cover-pending={article.cover.pendingAssetId}>
      <PreviewImage image={article.cover.image} label="An editorial garment study" priority sizes="(min-width: 1024px) 760px, calc(100vw - 40px)" />
      <p class="small-copy cover-note">Reused garment concept. A dedicated editorial cover is still pending; this image is not a client design or a factory record.</p>
    </div>}
    <div class="article-reading-grid">
      {toc.length > 0 && <nav class="article-toc" aria-label="On this page"><p class="eyebrow">On this page</p><ol>{toc.map(item => <li><a href={`#${item.id}`}>{item.text}</a></li>)}</ol></nav>}
      <div class="article-body"><EditorialBody body={article.body} /><div class="article-return"><a class="text-link" href="/blog/">← Back to Journal</a></div></div>
    </div>
  </article>
</BaseLayout>
