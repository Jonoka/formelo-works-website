---
import { homepageNavigation, demonstrationNavigation } from '../content/navigation';
import NavigationItem from './NavigationItem.astro';
interface Props { brandName: string }
const { brandName } = Astro.props;
---
<header class="site-header shell">
  <a class="wordmark" href="/" aria-label={`${brandName} home`}>{brandName}</a>
  <nav class="desktop-nav" aria-label="Main navigation">
    <details class="clothing-menu" data-nav-disclosure>
      <summary>Clothing <span class="disclosure-mark" aria-hidden="true"></span></summary>
      <ul class="clothing-menu-panel">
        {demonstrationNavigation.map(link => <li><NavigationItem {...link} description="Demonstration category" /></li>)}
      </ul>
    </details>
    {homepageNavigation.map(link => <NavigationItem {...link} />)}
  </nav>
  <details class="mobile-nav" data-nav-disclosure>
    <summary>Menu <span class="disclosure-mark" aria-hidden="true"></span></summary>
    <nav aria-label="Mobile navigation">
      <p class="eyebrow">Clothing / Demonstration categories</p>
      {demonstrationNavigation.map(link => <NavigationItem {...link} />)}
      {homepageNavigation.map(link => <NavigationItem {...link} />)}
      <p class="navigation-note">Explore the garment concepts, manufacturing guide and factory profile. Contact channels are not configured yet.</p>
    </nav>
  </details>
</header>
