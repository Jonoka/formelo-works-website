---
import type { ArticlePreview } from '../../../shared/editorial';
import PreviewImage from './PreviewImage.astro';
import { articlePath } from '../lib/editorial';
import '../styles/editorial.css';
interface Props { article: ArticlePreview; home?: boolean }
const { article, home = false } = Astro.props;
const Heading = home ? 'h3' : 'h2';
---
<article class="journal-card" data-article-card={article.slug} data-preview-status="editorial_draft" data-production-allowed="false" data-cover-usage={article.cover.usage} data-cover-pending={article.cover.pendingAssetId}>
  <PreviewImage image={article.cover.image} label="Editorial garment concept" sizes="(min-width: 1024px) 560px, (min-width: 768px) 44vw, calc(100vw - 40px)" />
  <p class="draft-status">Editorial draft / Not published</p>
  <Heading><a href={articlePath(article.slug)}>{article.title}</a></Heading>
  <p class="card-excerpt">{article.excerpt}</p>
  <p class="small-copy">Reused garment concept. Dedicated cover pending.</p>
</article>
