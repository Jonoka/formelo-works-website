---
import PendingContact from './PendingContact.astro';
import type { InformationPageDelivery } from '../../../shared/fixed-delivery';
interface Props { preview: InformationPageDelivery; eyebrow: string }
const { preview, eyebrow } = Astro.props;
---
<section class="information-hero shell" aria-labelledby="information-title">
  <div class="information-hero-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="information-title">{preview.title}</h1>
    <p class="intro">{preview.intro}</p>
    <p class="fact-note">{preview.factNote}</p>
    {preview.source === 'sanity' && <p class="small-copy" data-fact-review="recorded_not_verified">Fact-confirmation date recorded: {preview.factConfirmedAt}. The source record is not independent fact verification or website release approval.</p>}
    <PendingContact id={`${preview.pageKey}-contact-note`} referenceCode={preview.referenceCode} />
  </div>
  <div class="information-hero-aside"><slot /></div>
</section>
