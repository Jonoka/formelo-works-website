---
import type { Inline } from '../../../shared/editorial';
import { validateEditorialInline, validateEditorialLink } from '../../../shared/editorial-policy';
import EditorialText from './EditorialText.astro';
interface Props { content: Inline[] }
const { content } = Astro.props;
validateEditorialInline(content);
---
{content.map(item => item.type === 'text' ? <EditorialText item={item} /> : <a href={item.href} rel={validateEditorialLink(item.href) === 'source' ? 'nofollow noreferrer noopener' : undefined} data-editorial-source={validateEditorialLink(item.href) === 'source' ? 'reviewed' : undefined}><EditorialText item={item} /></a>)}
