---
import PendingContact from './PendingContact.astro';
import { footerNavigation } from '../content/navigation';
import NavigationItem from './NavigationItem.astro';
import type { ReferenceCode } from '../../../config/page-context';
interface Props { brandName: string; source: 'local' | 'sanity'; showMobileContact?: boolean; referenceCode: ReferenceCode | null }
const { brandName, source, showMobileContact = false, referenceCode } = Astro.props;
---
<footer class="site-footer" id="contact" tabindex="-1" aria-label="Site footer">
  <div class="shell">
    {referenceCode && <div class="footer-contact-row">
      <div><p class="eyebrow">The next conversation</p><h2 id="contact-heading">Get in touch.</h2></div>
      <div class="footer-contact-copy"><p>Bring your ideas, references and questions.<br />The right starting point is a clear brief.</p></div>
      {referenceCode && <PendingContact id="footer-contact-note" referenceCode={referenceCode} />}
    </div>}
    <div class="footer-bottom">
      <div><span class="wordmark">{brandName}</span><p class="footer-brand-note">{source === 'local' ? <>Apparel manufacturing for brands in motion.<br />Provisional brand · Factory facts awaiting confirmation.</> : <>Brand from the selected CMS settings.<br />Website release and contact activation are not verified.</>}</p></div>
      <nav aria-label="Footer navigation">{footerNavigation.map(link => <NavigationItem {...link} />)}</nav>
    </div>
  </div>
</footer>
{showMobileContact && referenceCode && <aside class="mobile-contact-bar" aria-label={source === 'local' ? 'Contact options — not configured' : 'Contact options — inactive'}><PendingContact id="mobile-contact-note" referenceCode={referenceCode} /></aside>}
