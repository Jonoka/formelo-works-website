---
import InformationLayout from '../layouts/InformationLayout.astro';
import InformationHero from '../components/InformationHero.astro';
import InformationRows from '../components/InformationRows.astro';
import FactoryPhotographyPending from '../components/FactoryPhotographyPending.astro';
import RelatedCategories from '../components/RelatedCategories.astro';
import ContentSectionHeading from '../components/ContentSectionHeading.astro';
import ContentImage from '../components/ContentImage.astro';
const site = Astro.locals.siteDelivery;
const preview = site.fixedPages.factory;
---
<InformationLayout preview={preview} brandName={site.shell.brandName}>
  <InformationHero preview={preview} eyebrow={preview.eyebrow}>{preview.heroImage ? <ContentImage image={preview.heroImage} label={preview.title} sizes="(min-width: 1024px) 42vw, 100vw" priority /> : <FactoryPhotographyPending />}</InformationHero>
  <section class="section-row section-grid shell" aria-labelledby="factory-overview-heading">
    <ContentSectionHeading id="factory-overview-heading" copy={preview.sections.overview} />
    <div class="factory-overview"><p class="serif">{preview.overview}</p><p class="section-note">{preview.overviewNote}</p></div>
  </section>
  <section class="section-row section-grid shell" id="arrangements" tabindex="-1" aria-labelledby="arrangements-heading">
    <ContentSectionHeading id="arrangements-heading" copy={preview.sections.arrangements} />
    <InformationRows rows={preview.arrangements} />
  </section>
  <section class="section-row shell factory-quality" id="quality" tabindex="-1" aria-labelledby="quality-heading">
    <div class="section-grid"><ContentSectionHeading id="quality-heading" copy={preview.sections.quality} showDescription={false} /><p class="intro">{preview.sections.quality.description}</p></div>
    <div class="information-cards">{preview.qualityDiscussion.map((row, index) => <article><p class="eyebrow">0{index + 1} / Review point</p><h3>{row.title}</h3><p>{row.description}</p></article>)}</div>
  </section>
  {preview.gallery.length > 0 && <section class="section-row shell" aria-labelledby="factory-material-heading" data-factory-gallery>
    <h2 class="serif" id="factory-material-heading">Supporting photographs</h2>
    <div class="evidence-grid">{preview.gallery.map(image => <ContentImage image={image} label="Factory supporting photograph" sizes="(min-width: 768px) 45vw, 100vw" />)}</div>
  </section>}
  {preview.credentials.length > 0 && <section class="section-row section-grid shell" aria-labelledby="factory-credentials-heading" data-factory-credentials>
    <h2 class="serif" id="factory-credentials-heading">Recorded credentials</h2><InformationRows rows={preview.credentials} />
  </section>}
  <section class="section-row section-grid shell" aria-labelledby="factory-related-heading">
    <ContentSectionHeading id="factory-related-heading" copy={preview.sections.related} />
    <div><RelatedCategories /><div class="information-next-links">{preview.relatedLinks.map(link => <a class="text-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}</div></div>
  </section>
</InformationLayout>
