---
import BaseLayout from '../layouts/BaseLayout.astro';
import PendingContact from '../components/PendingContact.astro';
import PreviewImage from '../components/PreviewImage.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import JournalCard from '../components/JournalCard.astro';
import FactoryPhotographyPending from '../components/FactoryPhotographyPending.astro';
import { categoryPath } from '../lib/category-preview';
import { loadContent } from '../lib/content';
import { readRuntime } from '../../../config/runtime';
import { pageContexts } from '../../../config/page-context';
const { siteSettings, home, homepagePreview, articlePreviews } = await loadContent(readRuntime().contentMode);
// Presentation hints must never replace an updated, authoritative page title.
const heroTitleLines = homepagePreview.heroTitleLines.join(' ') === home.title ? homepagePreview.heroTitleLines : [home.title];
---
<BaseLayout title={home.seo.seoTitle} description={home.seo.seoDescription} brandName={siteSettings.brandName} showMobileContact referenceCode={pageContexts.home.referenceCode}>
  <section class="hero shell" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow">{homepagePreview.eyebrow}</p>
      <h1 id="hero-heading">{heroTitleLines.map(line => <span class="hero-title-line">{line}{' '}</span>)}</h1>
      <p class="intro">{home.intro}</p>
      <p class="fact-note">{homepagePreview.heroFactNote}</p>
      <PendingContact id="hero-contact-note" referenceCode={pageContexts.home.referenceCode} />
      <a class="text-link" href="#capabilities">Explore the proposed approach <span aria-hidden="true">↓</span></a>
    </div>
    <PreviewImage image={homepagePreview.heroImage} label="Garments, considered." priority shape="square" sizes="(min-width: 1440px) 650px, (min-width: 768px) 48vw, calc(100vw - 40px)" />
  </section>

  <section class="section-row shell section-grid capabilities" id="capabilities" tabindex="-1" aria-labelledby="capabilities-heading">
    <div><SectionHeading id="capabilities-heading" eyebrow="From idea to enquiry" lines={['Capabilities']} note="Proposed service areas. Availability and scope are not yet factory-confirmed." /><a class="text-link" href="/manufacturing/">Read the manufacturing guide</a></div>
    <div class="capability-grid">
      {homepagePreview.capabilities.map(item => <div class="capability"><Icon name={item.icon} /><h3>{item.title}</h3><p>{item.description}</p></div>)}
    </div>
  </section>

  <section class="section-row shell section-grid" id="categories" tabindex="-1" aria-labelledby="categories-heading">
    <SectionHeading id="categories-heading" eyebrow="Explore the possibilities" lines={['Apparel', 'categories']} note="Two directions to frame a brief. Demonstrations only." />
    <div class="category-grid">
      {homepagePreview.demonstrationCategories.map((category, index) => (
        <article class="category-card" id={category.anchor} tabindex="-1" aria-labelledby={`${category.anchor}-heading`}>
          <div class="category-media"><span class="card-number" aria-hidden="true">0{index + 1}</span><PreviewImage image={category.image} label={category.name} sizes="(min-width: 1440px) 450px, (min-width: 1024px) 33vw, (min-width: 768px) 45vw, calc(100vw - 40px)" /></div>
          <div class="category-copy"><p class="eyebrow">Demonstration category</p><h3 id={`${category.anchor}-heading`}><a href={categoryPath(category.anchor)}>{category.name} <span aria-hidden="true">↗</span></a></h3><p>{category.description}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-row shell section-grid" id="factory" tabindex="-1" aria-labelledby="factory-heading">
    <div><SectionHeading id="factory-heading" eyebrow="Our factory / Profile pending" lines={['Behind', 'the garment.']} note="Know who makes your clothes. The factory profile, equipment details and original photography still need verification." /><a class="text-link" href="/our-factory/">Explore our factory profile</a></div>
    <FactoryPhotographyPending />
  </section>

  <section class="section-row shell section-grid" id="production" tabindex="-1" aria-labelledby="process-heading">
    <div><SectionHeading id="process-heading" eyebrow="How a project could take shape" lines={['A straightforward', 'process']} note="Illustrative workflow, not a confirmed factory procedure." /><a class="text-link" href="/manufacturing/#production">Explore the conceptual sequence</a></div>
    <ol class="process-grid">
      {homepagePreview.processSteps.map((step, index) => <li><span class="step-number">0{index + 1}</span><h3>{step.title}</h3><p>{step.description}</p>{index < homepagePreview.processSteps.length - 1 && <span class="step-arrow" aria-hidden="true">→</span>}</li>)}
    </ol>
  </section>

  <section class="section-row shell section-grid" id="journal" tabindex="-1" aria-labelledby="journal-heading">
    <SectionHeading id="journal-heading" eyebrow="Journal" lines={['Ideas, process', 'and perspectives']} />
    <div class="journal-content"><p class="journal-intro serif">Good questions come before good garments.</p><p>Two editorial drafts for your next brief. Not published or factory-approved.</p><div class="journal-grid home-journal-grid">{articlePreviews.map(article => <JournalCard article={article} home />)}</div><a class="text-link" href="/blog/">Explore the Journal</a></div>
  </section>

  <section class="section-row shell section-grid enquiry-guide" id="enquiry-guide" tabindex="-1" aria-labelledby="faq-heading">
    <SectionHeading id="faq-heading" eyebrow="Before the conversation" lines={['A little clarity.', 'A better brief.']} note="Start with the details that matter to your collection." />
    <FAQ items={home.faqItems} />
  </section>
</BaseLayout>
