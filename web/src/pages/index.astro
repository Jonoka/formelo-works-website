---
import BaseLayout from '../layouts/BaseLayout.astro';
import PendingContact from '../components/PendingContact.astro';
import { loadContent } from '../lib/content';
import { readRuntime } from '../../../config/runtime';
const { siteSettings, home } = await loadContent(readRuntime().contentMode);
---
<BaseLayout title={home.seo.seoTitle} description={home.seo.seoDescription} brandName={siteSettings.brandName}>
  <section class="hero shell" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow">Foundation / A work in progress</p>
      <h1 id="hero-heading">{home.title}</h1>
      <p class="intro">{home.intro}</p>
      <PendingContact id="hero-contact-note" />
      <a class="text-link" href="#foundation">About this foundation <span aria-hidden="true">↗</span></a>
    </div>
    <div class="media-placeholder" aria-labelledby="media-label">
      <span class="eyebrow">01 / Image space</span>
      <div class="placeholder-label">
        <p class="serif" id="media-label">Garment photography<br />pending.</p>
        <p>No factory or product photograph is supplied in this foundation.</p>
      </div>
      <span class="image-caption">A reserved space, not factory evidence.</span>
    </div>
  </section>
  <section class="foundation shell" id="foundation" aria-labelledby="foundation-heading">
    <div>
      <p class="eyebrow">The foundation</p>
      <h2 id="foundation-heading">Space for the<br />real details.</h2>
    </div>
    <div class="foundation-copy">
      <p>Editorial typography, warm neutrals and a restrained layout carry forward the selected direction. The rest begins with verified information, not invented promises.</p>
      {home.faqItems.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
