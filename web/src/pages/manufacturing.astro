---
import InformationLayout from '../layouts/InformationLayout.astro';
import InformationHero from '../components/InformationHero.astro';
import InformationRows from '../components/InformationRows.astro';
import RelatedCategories from '../components/RelatedCategories.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FAQ from '../components/FAQ.astro';
import { loadContent } from '../lib/content';
import { readRuntime } from '../../../config/runtime';
const { manufacturingPreview: preview, categoryPreviews, siteSettings } = await loadContent(readRuntime().contentMode);
const sections = [
  ['options', 'Ways to shape a brief'], ['moq', 'Minimum quantities'], ['prepare', 'What to prepare'],
  ['sampling', 'Sampling & confirmation'], ['production', 'A conceptual sequence'], ['faq', 'Common questions'],
] as const;
---
<InformationLayout preview={preview} brandName={siteSettings.brandName}>
  <InformationHero preview={preview} eyebrow="Manufacturing / Before the conversation">
    <nav class="guide-contents" aria-label="On this page"><p class="eyebrow">A clearer starting point</p><ol>{sections.map(([id, label], index) => <li><a href={`#${id}`}><span aria-hidden="true">0{index + 1}</span><span>{label}</span></a></li>)}</ol></nav>
  </InformationHero>
  <section class="section-row section-grid shell information-section" id="options" tabindex="-1" aria-labelledby="options-heading">
    <SectionHeading id="options-heading" eyebrow="01 / Customisation questions" lines={['Choose a starting point.']} note="Explain how far your idea has developed. These are discussion routes, not a confirmed list of services." />
    <div class="information-cards">{preview.options.map(row => <article><h3>{row.title}</h3><p>{row.description}</p></article>)}</div>
  </section>
  <section class="section-row section-grid shell information-section" id="moq" tabindex="-1" aria-labelledby="moq-heading">
    <SectionHeading id="moq-heading" eyebrow="02 / Minimum order quantities" lines={['Look beyond the total.']} note="Prepare a breakdown so the factory can explain which minimums would apply, and on what basis. No quantities are quoted in this preview." />
    <InformationRows rows={preview.moqFactors} />
  </section>
  <section class="section-row section-grid shell information-section" id="prepare" tabindex="-1" aria-labelledby="prepare-heading">
    <SectionHeading id="prepare-heading" eyebrow="03 / Your project brief" lines={['Start with what you know.']} note="A few useful details can frame the conversation. This is a guide to keep with your own notes, not a form or an upload request." />
    <div><InformationRows rows={preview.preparation} /><p class="information-note"><strong>No tech pack yet?</strong> An idea or a question is enough to begin a conversation. A tech pack, company email or registered brand is not a prerequisite.</p></div>
  </section>
  <section class="section-row section-grid shell information-section" id="sampling" tabindex="-1" aria-labelledby="sampling-heading">
    <SectionHeading id="sampling-heading" eyebrow="04 / Sampling & confirmation" lines={['Make the review specific.']} note="Identify what a physical sample would need to resolve before discussing a production commitment." />
    <div class="information-cards">{preview.sampling.map(row => <article><h3>{row.title}</h3><p>{row.description}</p></article>)}</div>
  </section>
  <section class="section-row section-grid shell information-section" id="production" tabindex="-1" aria-labelledby="production-heading">
    <SectionHeading id="production-heading" eyebrow="05 / Conceptual sequence" lines={['From brief to delivery.']} note="An illustrative sequence for discussion, not a confirmed factory procedure or an order tracker." />
    <ol class="process-grid">{preview.productionSteps.map((step, index) => <li><span class="step-number">0{index + 1}</span><h3>{step.title}</h3><p>{step.description}</p>{index < preview.productionSteps.length - 1 && <span class="step-arrow" aria-hidden="true">→</span>}</li>)}</ol>
  </section>
  <section class="section-row section-grid shell information-section" id="faq" tabindex="-1" aria-labelledby="manufacturing-faq-heading">
    <SectionHeading id="manufacturing-faq-heading" eyebrow="06 / Common questions" lines={['Before moving forward.']} />
    <FAQ items={preview.faqItems} />
  </section>
  <section class="section-row section-grid shell" aria-labelledby="manufacturing-related-heading">
    <SectionHeading id="manufacturing-related-heading" eyebrow="Put the brief in context" lines={['Consider the garment.']} note="Two demonstration categories, each with its own design questions. Neither is a confirmed factory catalogue." />
    <div><RelatedCategories categories={categoryPreviews} /><div class="information-next-links"><a class="text-link" href="/our-factory/">Explore our factory profile <span aria-hidden="true">↗</span></a><a class="text-link" href="/contact/">View contact options <span aria-hidden="true">↗</span></a></div></div>
  </section>
</InformationLayout>
