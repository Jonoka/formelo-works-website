---
import InformationLayout from '../layouts/InformationLayout.astro';
import InformationHero from '../components/InformationHero.astro';
import InformationRows from '../components/InformationRows.astro';
import RelatedCategories from '../components/RelatedCategories.astro';
import ContentSectionHeading from '../components/ContentSectionHeading.astro';
import MoqDetails from '../components/MoqDetails.astro';
import FAQ from '../components/FAQ.astro';
const site = Astro.locals.siteDelivery;
const preview = site.fixedPages.manufacturing;
const sections = [
  ['options', 'Ways to shape a brief'], ['moq', 'Minimum quantities'], ['prepare', 'What to prepare'],
  ['sampling', 'Sampling & confirmation'], ['production', 'A conceptual sequence'], ['faq', 'Common questions'],
] as const;
---
<InformationLayout preview={preview} brandName={site.shell.brandName}>
  <InformationHero preview={preview} eyebrow={preview.eyebrow}>
    <nav class="guide-contents" aria-label="On this page"><p class="eyebrow">{preview.guideTitle}</p><ol>{sections.map(([id, label], index) => <li><a href={`#${id}`}><span aria-hidden="true">0{index + 1}</span><span>{preview.source === 'local' ? label : preview.sections[id].title}</span></a></li>)}</ol></nav>
  </InformationHero>
  <section class="section-row section-grid shell information-section" id="options" tabindex="-1" aria-labelledby="options-heading">
    <ContentSectionHeading id="options-heading" copy={preview.sections.options} />
    <div class="information-cards">{preview.options.map(row => <article><h3>{row.title}</h3><p>{row.description}</p></article>)}</div>
  </section>
  <section class="section-row section-grid shell information-section" id="moq" tabindex="-1" aria-labelledby="moq-heading">
    <ContentSectionHeading id="moq-heading" copy={preview.sections.moq} />
    {preview.defaultMoq ? <div><MoqDetails policy={preview.defaultMoq} inheritance="inherit" /><InformationRows rows={preview.moqFactors} /></div> : <InformationRows rows={preview.moqFactors} />}
  </section>
  <section class="section-row section-grid shell information-section" id="prepare" tabindex="-1" aria-labelledby="prepare-heading">
    <ContentSectionHeading id="prepare-heading" copy={preview.sections.prepare} />
    <div><InformationRows rows={preview.preparation} /><p class="information-note"><strong>{preview.preparationLead}</strong> {preview.preparationNote}</p></div>
  </section>
  <section class="section-row section-grid shell information-section" id="sampling" tabindex="-1" aria-labelledby="sampling-heading">
    <ContentSectionHeading id="sampling-heading" copy={preview.sections.sampling} />
    <div class="information-cards">{preview.sampling.map(row => <article><h3>{row.title}</h3><p>{row.description}</p></article>)}</div>
  </section>
  <section class="section-row section-grid shell information-section" id="production" tabindex="-1" aria-labelledby="production-heading">
    <ContentSectionHeading id="production-heading" copy={preview.sections.production} />
    <ol class="process-grid">{preview.productionSteps.map((step, index) => <li><span class="step-number">0{index + 1}</span><h3>{step.title}</h3><p>{step.description}</p>{index < preview.productionSteps.length - 1 && <span class="step-arrow" aria-hidden="true">→</span>}</li>)}</ol>
  </section>
  <section class="section-row section-grid shell information-section" id="faq" tabindex="-1" aria-labelledby="manufacturing-faq-heading">
    <ContentSectionHeading id="manufacturing-faq-heading" copy={preview.sections.faq} />
    <FAQ items={preview.faqItems} />
  </section>
  <section class="section-row section-grid shell" aria-labelledby="manufacturing-related-heading">
    <ContentSectionHeading id="manufacturing-related-heading" copy={preview.sections.related} />
    <div><RelatedCategories /><div class="information-next-links">{preview.relatedLinks.map(link => <a class="text-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}</div></div>
  </section>
</InformationLayout>
