---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleDeliveryError from '../../components/ArticleDeliveryError.astro';
import { loadContent } from '../../lib/content';
import { loadArticleCollection, loadArticlePage } from '../../lib/server/article-delivery';
import { readRuntime } from '../../../../config/runtime';
import { articleScopes, articleSlug } from '../../../../shared/cms-article';
import { findDeliveredArticle, readArticleDeliveryMode } from '../../../../shared/article-delivery';
export async function getStaticPaths() {
  // Only a published build derives emitted routes from its shared snapshot. Dev keeps the fixed route scope,
  // not cached article props, so a reload reads a saved revision and errors reach the safe page state.
  const slugs = import.meta.env['FORMELO_ASTRO_COMMAND'] === 'build' && readArticleDeliveryMode(process.env) === 'published'
    ? (await loadArticleCollection({ command: import.meta.env['FORMELO_ASTRO_COMMAND'] })).articles.map(article => article.slug)
    : Object.keys(articleScopes);
  return slugs.map(slug => ({ params: { slug } }));
}
const slug = articleSlug(Astro.params.slug);
const { siteSettings } = await loadContent(readRuntime().contentMode);
const result = await loadArticlePage({ command: import.meta.env['FORMELO_ASTRO_COMMAND'], url: Astro.url });
const article = result.ok ? findDeliveredArticle(result.collection, slug) : undefined;
if (!result.ok) Astro.response.status = 503;
else if (!article) Astro.response.status = 404;
if (import.meta.env['FORMELO_ASTRO_COMMAND'] === 'dev') Astro.response.headers.set('Cache-Control', 'no-store');
---
{article ? <ArticleLayout article={article} brandName={siteSettings.brandName} /> : <BaseLayout title="Article unavailable" description="The selected article is unavailable. No local or unpublished substitute is shown." brandName={siteSettings.brandName} showMobileContact referenceCode={articleScopes[slug].referenceCode}>
  <Breadcrumb label="Article unavailable" journalParent />
  <section class="article-delivery-error-page shell"><h1>Article unavailable</h1><ArticleDeliveryError code={result.ok ? 'ARTICLE_NOT_IN_COLLECTION' : result.code} /><a class="text-link" href="/blog/">← Back to Journal</a></section>
</BaseLayout>}
