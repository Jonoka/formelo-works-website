---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PendingContact from '../../components/PendingContact.astro';
import JournalCard from '../../components/JournalCard.astro';
import { loadContent } from '../../lib/content';
import { readRuntime } from '../../../../config/runtime';
import { pageContexts } from '../../../../config/page-context';
const { siteSettings, articlePreviews } = await loadContent(readRuntime(import.meta.env).contentMode);
const context = pageContexts.blog;
---
<BaseLayout title="Journal — clothing project preparation" description="Two unpublished editorial drafts for clothing buyers: preparing a clear quotation brief and understanding quantities by style, color and size. Factory terms remain unconfirmed." brandName={siteSettings.brandName} showMobileContact referenceCode={context.referenceCode}>
  <Breadcrumb label="Journal" />
  <div class="journal-page shell" data-preview-kind="journal_preview" data-preview-status="editorial_draft" data-production-allowed="false">
    <header class="journal-header">
      <p class="eyebrow">Journal / Notes for your next collection</p>
      <h1>Journal</h1>
      <p class="intro">A clearer brief. A more useful conversation.</p>
      <p>Two complete editorial drafts to help organize your clothing project. Not published or factory-approved; they do not establish services, quantities or commercial terms.</p>
      <PendingContact id="journal-contact-note" referenceCode={context.referenceCode} />
    </header>
    <div class="journal-grid">{articlePreviews.map(article => <JournalCard article={article} />)}</div>
  </div>
</BaseLayout>
