---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PendingContact from '../../components/PendingContact.astro';
import JournalCard from '../../components/JournalCard.astro';
import ArticleDeliveryError from '../../components/ArticleDeliveryError.astro';
import { loadArticlePage } from '../../lib/server/article-delivery';
import { articleCollectionNotice } from '../../../../shared/article-delivery';
import { pageContexts } from '../../../../config/page-context';
const site = Astro.locals.siteDelivery;
const column = site.fixedPages.blogIndex;
const result = await loadArticlePage({ command: import.meta.env['FORMELO_ASTRO_COMMAND'], url: Astro.url });
if (!result.ok) Astro.response.status = 503;
if (import.meta.env['FORMELO_ASTRO_COMMAND'] === 'dev') Astro.response.headers.set('Cache-Control', 'no-store');
const context = pageContexts.blog;
---
<BaseLayout title={column.seo.seoTitle} description={column.seo.seoDescription} brandName={site.shell.brandName} showMobileContact referenceCode={context.referenceCode}>
  <Breadcrumb label="Journal" />
  <div class="journal-page shell" data-page-source={column.source} data-page-status={column.status} data-page-revision={column.revision} data-preview-kind="journal_preview" data-preview-status={result.ok && result.collection.mode === 'mock' ? 'editorial_draft' : result.ok ? result.collection.mode : 'unavailable'} data-production-allowed="false" data-article-mode={result.ok ? result.collection.mode : 'unavailable'}>
    <header class="journal-header">
      <p class="eyebrow">{column.eyebrow}</p>
      <h1>{column.title}</h1>
      <p class="intro">{column.intro}</p>
      {column.columnNote && <p data-column-note>{column.columnNote}</p>}
      {result.ok && <p>{articleCollectionNotice(result.collection.mode)}</p>}
      <PendingContact id="journal-contact-note" referenceCode={context.referenceCode} />
    </header>
    {result.ok ? <div class="journal-grid">{result.collection.articles.map(article => <JournalCard article={article} />)}</div> : <ArticleDeliveryError code={result.code} />}
  </div>
</BaseLayout>
